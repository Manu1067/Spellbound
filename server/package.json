{
  "name": "spellbound-server",
  "version": "1.0.0",
  "description": "Spellbound Wizarding Academy Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "db:reset": "node src/db/init.js --reset",
    "test": "node --test --test-concurrency=1 test/api.test.js test/e2e-journeys.test.js test/mysteries-intelligence.test.js"
  },
  "keywords": [
    "spellbound",
    "express",
    "sqlite",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
